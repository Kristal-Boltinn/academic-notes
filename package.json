    "test:electron": "node scripts/test-electron.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
